# Prettier owns formatting for the files it handles; this covers what it does not — the editor
# defaults every contributor's tooling applies before Prettier ever runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# A trailing double-space is a hard line break in markdown; stripping it silently reflows prose.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
